{
  "name": "@sjunepark/darty",
  "version": "0.0.2",
  "type": "module",
  "bin": {
    "darty": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --outfile=dist/cli.js --minify --sourcemap=none",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "env:check": "varlock load",
    "eval:contents:cli": "bun run evals/contents-search/cli/run-eval.ts",
    "eval:contents:agent:cli": "varlock run -- bun run evals/contents-search/agent-cli/run-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:live": "LIVE_DART_TESTS=1 bun test",
    "search": "bun run src/cli.ts contents-search"
  },
  "dependencies": {
    "@effect/platform": "^0.91.0",
    "cheerio": "^1.1.0",
    "commander": "^14.0.3",
    "effect": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "typescript": "^5.9.0",
    "varlock": "^0.9.0"
  }
}
