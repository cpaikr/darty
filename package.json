{
  "name": "@sjunepark/darty",
  "version": "0.4.0",
  "license": "Elastic-2.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjunepark/darty.git"
  },
  "bin": {
    "darty": "dist/cli.js"
  },
  "exports": {
    "./toolset": {
      "types": "./dist/toolset.d.ts",
      "import": "./dist/toolset.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "bun run scripts/build-cli.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test",
    "env:check": "varlock load",
    "check:axi": "bun run scripts/check-axi-upstream.ts",
    "eval:search-body:cli": "bun run evals/search-body/cli/run-eval.ts",
    "eval:search-body:agent:cli": "varlock run -- bun run evals/search-body/agent-cli/run-eval.ts",
    "eval:cli:search-body": "bun run evals/search-body/cli/run-eval.ts",
    "eval:agent-cli:search-body": "varlock run -- bun run evals/search-body/agent-cli/run-eval.ts",
    "eval:workflow:cli": "bun run evals/workflows/run-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:live": "LIVE_DART_TESTS=1 bun test",
    "search": "bun run src/cli.ts search-body"
  },
  "dependencies": {
    "@effect/platform": "^0.91.0",
    "cheerio": "^1.1.0",
    "commander": "^14.0.3",
    "domhandler": "^5.0.3",
    "effect": "^3.17.0",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.9.0",
    "varlock": "^0.9.0"
  }
}
