{
  "name": "darty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "env:check": "varlock load",
    "eval:contents:cli": "bun run evals/contents-search/run-cli-eval.ts",
    "eval:contents:agent:cli": "varlock run -- bun run evals/contents-search/run-agent-cli-eval.ts",
    "eval:contents:agent:mcp": "PROMPTFOO_CACHE_ENABLED=false PROMPTFOO_CONFIG_DIR=.promptfoo PROMPTFOO_DISABLE_WAL_MODE=true varlock run -- promptfoo eval -c evals/contents-search/promptfooconfig.agent.mcp.yaml",
    "mcp": "bun run src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:live": "LIVE_DART_TESTS=1 bun test",
    "search": "bun run src/cli.ts contents-search"
  },
  "dependencies": {
    "@effect/platform": "^0.91.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.1.0",
    "commander": "^14.0.3",
    "effect": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "promptfoo": "^0.121.9",
    "typescript": "^5.9.0",
    "varlock": "^0.9.0"
  }
}
