{
  "name": "@sjunepark/darty",
  "version": "0.1.2",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjunepark/darty.git"
  },
  "bin": {
    "darty": "dist/cli.js"
  },
  "exports": {
    "./toolset": {
      "types": "./dist/toolset.d.ts",
      "import": "./dist/toolset.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "TERMS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "bun run scripts/build-cli.ts",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test",
    "env:check": "varlock load",
    "eval:search-body:cli": "bun run evals/search-body/cli/run-eval.ts",
    "eval:search-body:agent:cli": "varlock run -- bun run evals/search-body/agent-cli/run-eval.ts",
    "eval:search-body:agent:native": "varlock run -- bun run evals/search-body/agent-native/run-eval.ts",
    "eval:workflows:agent:native": "varlock run -- bun run evals/workflows/agent-native/run-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:live": "LIVE_DART_TESTS=1 bun test",
    "search": "bun run src/cli.ts search-body"
  },
  "dependencies": {
    "@effect/platform": "^0.91.0",
    "cheerio": "^1.1.0",
    "commander": "^14.0.3",
    "domhandler": "^5.0.3",
    "effect": "^3.17.0",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.4",
    "@types/bun": "^1.3.1",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.9.0",
    "varlock": "^0.9.0"
  }
}