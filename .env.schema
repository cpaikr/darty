# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# Selects environment-specific overlays such as `.env.test.local` when needed.
# @type=enum(development, test, preview, production)
APP_ENV=development

# OpenAI API key for Promptfoo MCP evals and the custom agentic CLI invocation eval.
# Keep the real value in `.env.local` on your machine.
# @required
# @sensitive
# @type=string(startsWith=sk-)
OPENAI_API_KEY=
